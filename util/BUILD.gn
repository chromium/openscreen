import("//build/config/rust.gni")
import("//build_overrides/build.gni")
import("../gni/openscreen.gni")

declare_args() {
  # Enables trace logging in build. This is true by default, but may be disabled
  # for a slight performance increase.
  enable_trace_logging = true

  # Enables the Rust serde_json_lenient backend for JSON parsing and
  # serialization. The jsoncpp backend is always built, so the backend can be
  # chosen at runtime.
  use_json_serde = enable_rust
}

assert(!use_json_serde || enable_rust,
       "use_json_serde requires enable_rust = true.")

if (use_json_serde) {
  import("//build/rust/rust_static_library.gni")
}

visibility = [ "../*" ]

config("trace_logging_config") {
  if (enable_trace_logging) {
    defines = [ "ENABLE_TRACE_LOGGING" ]
  }
}

config("json_serde_config") {
  if (use_json_serde) {
    defines = [ "USE_JSON_SERDE" ]
  }
}

if (use_json_serde) {
  rust_static_library("json_serde") {
    crate_root = "json/serde_json.rs"
    allow_unsafe = true
    sources = [ "json/serde_json.rs" ]
    cxx_bindings = [ "json/serde_json.rs" ]
    deps = [
      "//third_party/jsoncpp",
      "//third_party/rust/serde/v1:lib",
      "//third_party/rust/serde_json_lenient/v0_2:lib",
    ]
    configs += openscreen_add_public_configs
    configs += [ ":json_serde_config" ]
  }
}

openscreen_source_set("util") {
  public = [
    "alarm.h",
    "base64.h",
    "big_endian.h",
    "bit_vector.h",
    "chrono_helpers.h",
    "crypto/certificate_utils.h",
    "crypto/digest_sign.h",
    "crypto/openssl_util.h",
    "crypto/pem_helpers.h",
    "crypto/random_bytes.h",
    "crypto/sha2.h",
    "enum_name_table.h",
    "flat_map.h",
    "hashing.h",
    "integer_division.h",
    "json/json_helpers.h",
    "json/json_serialization.h",
    "json/json_value.h",
    "no_destructor.h",
    "osp_logging.h",
    "raw_ptr.h",
    "raw_ref.h",
    "read_file.h",
    "saturate_cast.h",
    "simple_fraction.h",
    "std_util.h",
    "string_parse.h",
    "string_util.h",
    "thread_annotations.h",
    "trace_logging.h",
    "uuid.h",
    "weak_ptr.h",
  ]

  sources = [
    "alarm.cc",
    "base64.cc",
    "big_endian.cc",
    "bit_vector.cc",
    "crypto/certificate_utils.cc",
    "crypto/digest_sign.cc",
    "crypto/openssl_util.cc",
    "crypto/pem_helpers.cc",
    "crypto/random_bytes.cc",
    "crypto/sha2.cc",
    "json/json_serialization.cc",
    "json/json_serialization_internal.h",
    "json/json_serialization_jsoncpp.cc",
    "json/json_value.cc",
    "read_file.cc",
    "scoped_wake_lock.cc",
    "simple_fraction.cc",
    "trace_logging/macro_support.h",
    "trace_logging/scoped_trace_operations.cc",
    "trace_logging/scoped_trace_operations.h",
    "uuid.cc",
  ]

  deps = [
    "../third_party/boringssl",

    # We do a clone of Chrome's modp_b64 in order to share their BUILD.gn
    # and license files, so this should always be an absolute reference.
    "//third_party/modp_b64",
  ]

  if (use_json_serde) {
    sources += [
      "json/json_serialization_serde.cc",
      "json/json_serialization_serde_internal.h",
    ]
    deps += [ ":json_serde" ]
  }

  public_deps = [
    "../platform:api",
    "../platform:base",
    "../platform:logging",
    "../third_party/boringssl",
    "../third_party/jsoncpp",
  ]

  public_configs = [
    ":trace_logging_config",
    ":json_serde_config",
  ]

  friend = [ ":unittests" ]

  if (is_mac) {
    frameworks = [
      "CoreFoundation.framework",
      "IOKit.framework",
    ]
    sources += [ "scoped_wake_lock_mac.cc" ]
  }

  if (is_linux) {
    sources += [ "scoped_wake_lock_linux.cc" ]
  }

  # When building with Chromium, we depend on base for its implementation of
  # raw_ptr and PartitionAlloc.
  if (build_with_chromium) {
    public_deps += [ "//base/allocator/partition_allocator:raw_ptr" ]
  }
}

openscreen_source_set("unittests") {
  testonly = true

  sources = [
    "alarm_unittest.cc",
    "base64_unittest.cc",
    "big_endian_unittest.cc",
    "bit_vector_unittest.cc",
    "crypto/certificate_utils_unittest.cc",
    "crypto/random_bytes_unittest.cc",
    "crypto/sha2_unittest.cc",
    "enum_name_table_unittest.cc",
    "flat_map_unittest.cc",
    "integer_division_unittest.cc",
    "json/json_helpers_unittest.cc",
    "json/json_serialization_unittest.cc",
    "json/json_value_unittest.cc",
    "raw_ptr_unittest.cc",
    "raw_ref_unittest.cc",
    "saturate_cast_unittest.cc",
    "simple_fraction_unittest.cc",
    "std_util_unittest.cc",
    "string_parse_unittest.cc",
    "string_util_unittest.cc",
    "trace_logging/scoped_trace_operations_unittest.cc",
    "uuid_unittest.cc",
    "weak_ptr_unittest.cc",
  ]

  # The trace logging unittests depend on macros only defined
  # when trace logging is enabled.
  if (enable_trace_logging) {
    sources += [ "trace_logging_unittest.cc" ]
  }

  deps = [
    ":util",
    "../platform:test",
    "../third_party/boringssl",
    "../third_party/googletest:gmock",
    "../third_party/googletest:gtest",
    "../third_party/jsoncpp",
  ]

  if (is_linux) {
    sources += [ "scoped_wake_lock_linux_unittest.cc" ]
  }
}
